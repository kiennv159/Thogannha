rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (uid)
    // Fields:
    //   - uid: string (required)
    //   - email: string (required, email)
    //   - displayName: string
    //   - photoURL: string
    //   - role: string (required, 'customer'|'worker')
    //   - location: map { latitude: number, longitude: number }
    //   - services: list of strings
    //   - bio: string
    //   - rating: number
    //   - reviewCount: number
    //   - isOnline: bool
    //   - createdAt: timestamp
    //
    // Collection: requests
    // Document ID: requestId
    // Fields:
    //   - customerId: string (required)
    //   - workerId: string
    //   - serviceType: string (required)
    //   - description: string
    //   - status: string (required, 'pending'|'accepted'|'completed'|'cancelled')
    //   - location: map { latitude: number, longitude: number, address: string }
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //
    // Collection: reviews
    // Document ID: reviewId
    // Fields:
    //   - requestId: string (required)
    //   - customerId: string (required)
    //   - workerId: string (required)
    //   - rating: number (required, 1-5)
    //   - comment: string
    //   - createdAt: timestamp
    //
    // Collection: chats
    // Document ID: chatId
    // Fields:
    //   - requestId: string (required)
    //   - participants: list of strings (required)
    //   - lastMessage: string
    //   - updatedAt: timestamp
    //
    // Collection: messages (subcollection of chats)
    // Document ID: messageId
    // Fields:
    //   - senderId: string (required)
    //   - text: string (required)
    //   - createdAt: timestamp (required)
    //
    // Collection: subscriptions
    // Document ID: subscriptionId
    // Fields:
    //   - userId: string (required)
    //   - plan: string (required, 'free'|'pro'|'premium')
    //   - status: string (required, 'active'|'expired')
    //   - startDate: timestamp
    //   - endDate: timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((request.auth.token.email == "haubg.info@gmail.com" && request.auth.token.email_verified == true) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUser(data) {
      return data.get('uid', '') is string &&
             data.get('email', '') is string &&
             data.get('role', '') in ['customer', 'worker', 'admin'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('photoURL' in data) || (data.photoURL is string)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() < 1000)) &&
             (!('createdAt' in data) || (data.createdAt is string || data.createdAt is timestamp)) &&
             (!('location' in data) || (data.location is map));
    }

    function isValidRequest(data) {
      return data.get('customerId', '') is string &&
             data.get('serviceType', '') is string &&
             data.get('status', '') in ['pending', 'accepted', 'completed', 'cancelled', 'paid'] &&
             (!('description' in data) || (data.description is string && data.description.size() < 2000)) &&
             (!('price' in data) || data.price is number) &&
             (!('paymentMethod' in data) || data.paymentMethod in ['cash', 'transfer']);
    }

    function isValidChat(data) {
      return data.get('requestId', '') is string &&
             data.get('participants', []) is list &&
             data.participants.size() == 2;
    }

    function isValidMessage(data) {
      return data.get('senderId', '') is string &&
             data.get('text', '') is string &&
             data.text.size() > 0 && data.text.size() < 1000;
    }

    function isValidSubscription(data) {
      return data.get('userId', '') is string &&
             data.get('plan', '') in ['free', 'pro', 'premium'] &&
             data.get('status', '') in ['active', 'expired'];
    }

    function isValidReview(data) {
      return data.get('requestId', '') is string &&
             data.get('customerId', '') is string &&
             data.get('workerId', '') is string &&
             data.get('rating', 0) is number && data.rating >= 1 && data.rating <= 5;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) || 
        isAdmin() || 
        (resource.data.role == 'worker' && resource.data.isApproved == true)
      );
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && uidUnchanged();
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && uidNotModified() && request.resource.data.role == resource.data.role) || isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.customerId || 
        request.auth.uid == resource.data.workerId ||
        isAdmin() ||
        (resource.data.status == 'pending' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'worker')
      );
      allow create: if isAuthenticated() && 
                      request.resource.data.customerId == request.auth.uid &&
                      isValidRequest(request.resource.data);
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.customerId && isValidRequest(request.resource.data)) ||
        (request.auth.uid == resource.data.workerId && isValidRequest(request.resource.data)) ||
        (resource.data.status == 'pending' && request.resource.data.status == 'accepted' && request.resource.data.workerId == request.auth.uid) ||
        isAdmin()
      );
    }

    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                      request.resource.data.customerId == request.auth.uid &&
                      isValidReview(request.resource.data);
      allow delete: if isAdmin();
      allow update: if isAdmin();
    }
    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants && isValidChat(request.resource.data);
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() && 
                        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                        request.resource.data.senderId == request.auth.uid &&
                        isValidMessage(request.resource.data);
      }
    }

    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
    }
  }
}
